  "periods": [
    {
      "code": "roman_republic",
      "years": [
        -509,
        -27
      ],
      "name": {
        "zh": "罗马共和国",
        "en": "Roman Republic"
      },
      "brief": {
        "zh": "从王政被推翻到奥古斯都掌权之间的罗马国家。",
        "en": "The Roman state from the overthrow of the monarchy to the accession of Augustus."
      },
      "notes": "罗马共和国；年份为惯用近似。"
    },
    {
      "code": "roman_empire_period",
      "years": [
        -27,
        476
      ],
      "name": {
        "zh": "罗马帝国",
        "en": "Roman Empire"
      },
      "brief": {
        "zh": "罗马帝国时期；惯用断代终点为西罗马帝国灭亡。",
        "en": "The imperial Roman state; the conventional end date marks the fall of the western empire."
      },
      "notes": "以西部帝国灭亡为断代的罗马帝国时期（东部延续至1453年）。"
    },
    {
      "code": "late_antiquity",
      "years": [
        284,
        700
      ],
      "name": {
        "zh": "晚期古代",
        "en": "Late Antiquity"
      },
      "brief": {
        "zh": "古典古代与中世纪之间的过渡时代。",
        "en": "The transitional era between classical antiquity and the Middle Ages."
      },
      "notes": "晚期古代；学界界定不一，与其他时期有意重叠。"
    },
    {
      "code": "migration_period",
      "years": [
        375,
        568
      ],
      "name": {
        "zh": "民族大迁徙时期",
        "en": "Migration Period"
      },
      "brief": {
        "zh": "各人群大规模迁入罗马世界及其周边的时期。",
        "en": "The period of large-scale movements of peoples into the Roman world."
      },
      "notes": "民族大迁徙时期；起讫年份为惯用近似。"
    },
    {
      "code": "early_middle_ages",
      "years": [
